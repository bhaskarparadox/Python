class SensorData {
  final double temperature;
  final double humidity;
  final double tdsLevel;
  final double phLevel;
  final double waterLevel;
  final DateTime timestamp;
  
  SensorData({
    required this.temperature,
    required this.humidity,
    required this.tdsLevel,
    required this.phLevel,
    required this.waterLevel,
    required this.timestamp,
  });
  
  factory SensorData.fromMap(Map<dynamic, dynamic> map) {
    return SensorData(
      temperature: double.tryParse(map['temperature']?.toString() ?? '0') ?? 0,
      humidity: double.tryParse(map['humidity']?.toString() ?? '0') ?? 0,
      tdsLevel: double.tryParse(map['tdsLevel']?.toString() ?? '0') ?? 0,
      phLevel: double.tryParse(map['phLevel']?.toString() ?? '0') ?? 0,
      waterLevel: double.tryParse(map['waterLevel']?.toString() ?? '0') ?? 0,
      timestamp: map['timestamp'] != null 
          ? DateTime.fromMillisecondsSinceEpoch(map['timestamp'])
          : DateTime.now(),
    );
  }
  
  Map<String, dynamic> toMap() {
    return {
      'temperature': temperature,
      'humidity': humidity,
      'tdsLevel': tdsLevel,
      'phLevel': phLevel,
      'waterLevel': waterLevel,
      'timestamp': timestamp.millisecondsSinceEpoch,
    };
  }

  String getStatus(String parameter) {
    switch (parameter) {
      case 'temperature':
        if (temperature >= 18 && temperature <= 26) return "Good";
        return temperature < 18 ? "Cold" : "Hot";
      case 'humidity':
        if (humidity >= 50 && humidity <= 70) return "Good";
        return humidity < 50 ? "Low" : "High";
      case 'tds':
        if (tdsLevel >= 600 && tdsLevel <= 1000) return "Good";
        return tdsLevel < 600 ? "Low" : "High";
      case 'ph':
        if (phLevel >= 5.5 && phLevel <= 6.5) return "Normal";
        return phLevel < 5.5 ? "Low" : "High";
      case 'waterLevel':
        if (waterLevel >= 30 && waterLevel <= 80) return "Good";
        return waterLevel < 30 ? "Low" : "High";
      default:
        return "Unknown";
    }
  }
}
