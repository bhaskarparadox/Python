import 'package:firebase_database/firebase_database.dart';
import 'package:firebase_storage/firebase_storage.dart';
import '../models/sensor_data.dart';
import '../models/plant_profile.dart';
import '../models/alert.dart';

class FirebaseService {
  static final FirebaseService _instance = FirebaseService._internal();
  factory FirebaseService() => _instance;
  FirebaseService._internal();
  
  final DatabaseReference _database = FirebaseDatabase.instance.ref();
  final FirebaseStorage _storage = FirebaseStorage.instance;
  
  // Sensor Data
  Stream<SensorData> getSensorDataStream() {
    return _database.child('sensor_data').onValue.map((event) {
      if (event.snapshot.value != null) {
        return SensorData.fromMap(event.snapshot.value as Map);
      }
      return SensorData(
        temperature: 0,
        humidity: 0,
        tdsLevel: 0,
        phLevel: 0,
        waterLevel: 0,
        timestamp: DateTime.now(),
      );
    });
  }
  
  Future<void> updateSensorData(SensorData data) async {
    await _database.child('sensor_data').update(data.toMap());
  }
  
  // Historical Data
  Future<void> saveHistoricalData(SensorData data) async {
    final timestamp = data.timestamp.millisecondsSinceEpoch;
    await _database
        .child('historical_data')
        .child(timestamp.toString())
        .set(data.toMap());
  }
  
  Future<List<SensorData>> getHistoricalData(DateTime start, DateTime end) async {
    final snapshot = await _database
        .child('historical_data')
        .orderByKey()
        .startAt(start.millisecondsSinceEpoch.toString())
        .endAt(end.millisecondsSinceEpoch.toString())
        .get();
    
    if (snapshot.value != null) {
      final data = snapshot.value as Map;
      return data.entries
          .map((entry) => SensorData.fromMap(entry.value))
          .toList()
        ..sort((a, b) => a.timestamp.compareTo(b.timestamp));
    }
    return [];
  }
  
  // Device Control
  Stream<Map<String, bool>> getDeviceStatusStream() {
    return _database.child('sensor_data/controls').onValue.map((event) {
      if (event.snapshot.value != null) {
        final data = event.snapshot.value as Map;
        return Map<String, bool>.from(data.map((key, value) => 
            MapEntry(key.toString(), value as bool)));
      }
      return {};
    });
  }
  
  Future<void> updateDeviceStatus(String device, bool status) async {
    await _database.child('sensor_data/controls/$device').set(status);
  }
  
  // System Settings
  Stream<bool> getAutoModeStream() {
    return _database.child('system_settings/autoMode').onValue.map((event) {
      return event.snapshot.value as bool? ?? false;
    });
  }
  
  Future<void> setAutoMode(bool enabled) async {
    await _database.child('system_settings').update({
      'autoMode': enabled,
      'autoModeLastRun': DateTime.now().millisecondsSinceEpoch,
    });
  }
  
  // Plant Profiles
  Future<void> savePlantProfile(PlantProfile profile) async {
    await _database
        .child('plant_profiles')
        .child(profile.id)
        .set(profile.toMap());
  }
  
  Stream<List<PlantProfile>> getPlantProfilesStream() {
    return _database.child('plant_profiles').onValue.map((event) {
      if (event.snapshot.value != null) {
        final data = event.snapshot.value as Map;
        return data.entries
            .map((entry) => PlantProfile.fromMap(
                entry.key.toString(), 
                entry.value as Map))
            .toList();
      }
      return [];
    });
  }
  
  Future<void> setActivePlant(String plantId) async {
    await _database.child('settings/activePlant').set(plantId);
  }
  
  Stream<String?> getActivePlantStream() {
    return _database.child('settings/activePlant').onValue.map((event) {
      return event.snapshot.value as String?;
    });
  }
  
  // Alerts
  Future<void> createAlert(Alert alert) async {
    await _database
        .child('alerts')
        .child(alert.id)
        .set(alert.toMap());
  }
  
  Stream<List<Alert>> getAlertsStream() {
    return _database
        .child('alerts')
        .orderByChild('timestamp')
        .limitToLast(50)
        .onValue
        .map((event) {
      if (event.snapshot.value != null) {
        final data = event.snapshot.value as Map;
        return data.entries
            .map((entry) => Alert.fromMap(
                entry.key.toString(), 
                entry.value as Map))
            .toList()
          ..sort((a, b) => b.timestamp.compareTo(a.timestamp));
      }
      return [];
    });
  }
  
  Future<void> acknowledgeAlert(String alertId) async {
    await _database.child('alerts/$alertId/status').set('acknowledged');
  }
  
  Future<void> resolveAlert(String alertId) async {
    await _database.child('alerts/$alertId/status').set('resolved');
  }
  
  // Settings
  Future<Map<String, dynamic>> getSettings() async {
    final snapshot = await _database.child('settings').get();
    if (snapshot.value != null) {
      return Map<String, dynamic>.from(snapshot.value as Map);
    }
    return {};
  }
  
