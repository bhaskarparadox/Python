  Future<void> showAlert(Alert alert) async {
    final channelId = alert.severity == AlertSeverity.critical || 
                     alert.severity == AlertSeverity.emergency
        ? AppConstants.criticalChannelId
        : AppConstants.notificationChannelId;
    
    final androidDetails = AndroidNotificationDetails(
      channelId,
      channelId == AppConstants.criticalChannelId 
          ? AppConstants.criticalChannelName
          : AppConstants.notificationChannelName,
      importance: _getImportance(alert.severity),
      priority: _getPriority(alert.severity),
      styleInformation: BigTextStyleInformation(alert.message),
      color: alert.severityColor,
    );
    
    const iosDetails = DarwinNotificationDetails(
      presentAlert: true,
      presentBadge: true,
      presentSound: true,
    );
    
    final details = NotificationDetails(
      android: androidDetails,
      iOS: iosDetails,
    );
    
    await _notifications.show(
      alert.id.hashCode,
      alert.title,
      alert.message,
      details,
      payload: alert.id,
    );
  }
  
