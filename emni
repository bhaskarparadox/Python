  List<String> _generateRecommendations(Map<String, Map<String, double>> stats) {
    final recommendations = <String>[];
    
    // Temperature recommendations
    final tempAvg = stats['temperature']?['avg'] ?? 0;
    if (tempAvg < 18) {
      recommendations.add('Average temperature is below optimal. Consider increasing ambient temperature or using heaters.');
    } else if (tempAvg > 26) {
      recommendations.add('Average temperature is above optimal. Improve ventilation or add cooling systems.');
    }
    
    // pH recommendations
    final phAvg = stats['ph']?['avg'] ?? 0;
    if (phAvg < 5.5) {
      recommendations.add('pH levels are too acidic. Add pH up solution to increase pH.');
    } else if (phAvg > 6.5) {
      recommendations.add('pH levels are too alkaline. Add pH down solution to decrease pH.');
    }
    
    // TDS recommendations
    final tdsAvg = stats['tds']?['avg'] ?? 0;
    if (tdsAvg < 600) {
      recommendations.add('Nutrient concentration is low. Consider adding more nutrients.');
    } else if (tdsAvg > 1000) {
      recommendations.add('Nutrient concentration is high. Dilute with fresh water.');
    }
    
    // Water level recommendations
    final waterMin = stats['waterLevel']?['min'] ?? 0;
    if (waterMin < 30) {
      recommendations.add('Water levels dropped below 30%. Ensure automatic refill system is working.');
    }
    
    if (recommendations.isEmpty) {
      recommendations.add('All parameters are within optimal ranges. Keep up the good work!');
    }
    
    return recommendations;
  }
  
  Future<File> _savePDF(pw.Document pdf, String filename) async {
