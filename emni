      case AlertSeverity.info:
        return Priority.low;
      case AlertSeverity.warning:
        return Priority.defaultPriority;
      case AlertSeverity.critical:
        return Priority.high;
      case AlertSeverity.emergency:
        return Priority.max;
    }
  }
