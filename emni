  Map<String, Map<String, double>> _calculateStatistics(List<SensorData> data) {
    if (data.isEmpty) return {};
    
    final stats = <String, Map<String, double>>{};
    
    // Temperature stats
    final temps = data.map((d) => d.temperature).toList();
    stats['temperature'] = {
      'min': temps.reduce((a, b) => a < b ? a : b),
      'max': temps.reduce((a, b) => a > b ? a : b),
      'avg': temps.reduce((a, b) => a + b) / temps.length,
    };
    
    // Humidity stats
    final humidities = data.map((d) => d.humidity).toList();
    stats['humidity'] = {
      'min': humidities.reduce((a, b) => a < b ? a : b),
      'max': humidities.reduce((a, b) => a > b ? a : b),
      'avg': humidities.reduce((a, b) => a + b) / humidities.length,
    };
    
    // TDS stats
    final tdsLevels = data.map((d) => d.tdsLevel).toList();
    stats['tds'] = {
      'min': tdsLevels.reduce((a, b) => a < b ? a : b),
      'max': tdsLevels.reduce((a, b) => a > b ? a : b),
      'avg': tdsLevels.reduce((a, b) => a + b) / tdsLevels.length,
    };
    
    // pH stats
    final phLevels = data.map((d) => d.phLevel).toList();
    stats['ph'] = {
      'min': phLevels.reduce((a, b) => a < b ? a : b),
      'max': phLevels.reduce((a, b) => a > b ? a : b),
      'avg': phLevels.reduce((a, b) => a + b) / phLevels.length,
