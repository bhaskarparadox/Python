enum AlertSeverity { info, warning, critical, emergency }
enum AlertStatus { active, acknowledged, resolved }

class Alert {
  final String id;
  final String title;
  final String message;
  final AlertSeverity severity;
  final AlertStatus status;
  final DateTime timestamp;
  final String? parameter;
  final double? value;
  final Map<String, double>? thresholds;
  
  Alert({
    required this.id,
    required this.title,
    required this.message,
    required this.severity,
    required this.status,
    required this.timestamp,
    this.parameter,
    this.value,
    this.thresholds,
  });
  
  factory Alert.fromMap(String id, Map<dynamic, dynamic> map) {
    return Alert(
      id: id,
      title: map['title'] ?? '',
      message: map['message'] ?? '',
      severity: AlertSeverity.values.firstWhere(
        (e) => e.toString().split('.').last == map['severity'],
        orElse: () => AlertSeverity.info,
      ),
      status: AlertStatus.values.firstWhere(
        (e) => e.toString().split('.').last == map['status'],
        orElse: () => AlertStatus.active,
      ),
      timestamp: DateTime.fromMillisecondsSinceEpoch(map['timestamp'] ?? 0),
      parameter: map['parameter'],
      value: double.tryParse(map['value']?.toString() ?? ''),
      thresholds: map['thresholds'] != null 
          ? Map<String, double>.from(map['thresholds'])
          : null,
    );
  }
  
  Map<String, dynamic> toMap() {
    return {
      'title': title,
      'message': message,
      'severity': severity.toString().split('.').last,
      'status': status.toString().split('.').last,
      'timestamp': timestamp.millisecondsSinceEpoch,
      'parameter': parameter,
      'value': value,
      'thresholds': thresholds,
    };
  }
  
  Color get severityColor {
    switch (severity) {
      case AlertSeverity.info:
        return Colors.blue;
      case AlertSeverity.warning:
        return Colors.orange;
      case AlertSeverity.critical:
        return Colors.red;
      case AlertSeverity.emergency:
        return Colors.purple;
    }
  }
  
  IconData get severityIcon {
    switch (severity) {
      case AlertSeverity.info:
        return Icons.info_outline;
      case AlertSeverity.warning:
        return Icons.warning_amber_outlined;
      case AlertSeverity.critical:
        return Icons.error_outline;
      case AlertSeverity.emergency:
        return Icons.notification_important_outlined;
    }
  }
}
