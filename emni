            error,
            textAlign: TextAlign.center,
            style: const TextStyle(color: Colors.grey),
          ),
          const SizedBox(height: 16),
          ElevatedButton(
            onPressed: () {
              setState(() {});
            },
            child: const Text('Retry'),
          ),
        ],
      ),
    );
  }
  
  Widget _buildHealthIndicator(SensorData data) {
    int healthScore = 100;
    String healthStatus = 'Excellent';
    Color healthColor = AppTheme.successColor;
    
    // Calculate health score based on parameters
    if (data.temperature < 18 || data.temperature > 26) healthScore -= 20;
    if (data.humidity < 50 || data.humidity > 70) healthScore -= 15;
    if (data.phLevel < 5.5 || data.phLevel > 6.5) healthScore -= 25;
    if (data.tdsLevel < 600 || data.tdsLevel > 1000) healthScore -= 20;
    if (data.waterLevel < 30) healthScore -= 20;
    
    if (healthScore >= 80) {
      healthStatus = 'Excellent';
      healthColor = AppTheme.successColor;
    } else if (healthScore >= 60) {
      healthStatus = 'Good';
      healthColor = Colors.blue;
    } else if (healthScore >= 40) {
      healthStatus = 'Fair';
      healthColor = AppTheme.warningColor;
    } else {
      healthStatus = 'Poor';
      healthColor = AppTheme.errorColor;
    }
    
    return Row(
      children: [
        Expanded(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(
                'Overall Status',
                style: TextStyle(
                  color: Colors.grey[600],
                  fontSize: 14,
                ),
              ),
              const SizedBox(height: 4),
              Text(
                healthStatus,
                style: TextStyle(
                  fontSize: 24,
                  fontWeight: FontWeight.bold,
                  color: healthColor,
                ),
              ),
            ],
          ),
        ),
        Container(
          width: 80,
          height: 80,
          decoration: BoxDecoration(
            shape: BoxShape.circle,
            color: healthColor.withOpacity(0.1),
          ),
          child: Center(
            child: Text(
              '$healthScore%',
              style: TextStyle(
                fontSize: 24,
                fontWeight: FontWeight.bold,
                color: healthColor,
              ),
            ),
          ),
        ),
      ],
    );
  }
  
  Color _getTemperatureColor(double temp) {
    if (temp >= 18 && temp <= 26) return AppTheme.successColor;
    if (temp < 10 || temp > 35) return AppTheme.errorColor;
    return AppTheme.warningColor;
  }
  
  Color _getHumidityColor(double humidity) {
    if (humidity >= 50 && humidity <= 70) return AppTheme.successColor;
    if (humidity < 30 || humidity > 85) return AppTheme.errorColor;
    return AppTheme.warningColor;
  }
  
  Color _getPhColor(double ph) {
    if (ph >= 5.5 && ph <= 6.5) return AppTheme.successColor;
    if (ph < 4.5 || ph > 8.0) return AppTheme.errorColor;
    return AppTheme.warningColor;
  }
}
